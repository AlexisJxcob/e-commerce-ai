<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        OWASP Dependency-Check — clasificación de falsos positivos.

        Cada entrada <suppress> documenta un hallazgo que NO es explotable
        en el contexto de este proyecto (CPE incorrecto, librería no usada
        en runtime, versión no afectada...). Añadir entradas SOLO cuando
        exista una justificación verificable, y revisarlas al actualizar
        dependencias. Todo lo que no esté aquí y tenga CVSS >= 7.0 rompe
        el build del workflow CI (perfil "owasp" del pom.xml).
    -->

    <!-- Ejemplo real (descomentar y adaptar):
    <suppress>
        <notes><![CDATA[
            Falso positivo: el CVE-XXXX-XXXX afecta al componente de
            servidor de la librería, que no se usa en esta aplicación
            (solo la variante cliente).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.example/artifact@.*$</packageUrl>
        <cve>CVE-XXXX-XXXX</cve>
    </suppress>
    -->
</suppressions>
