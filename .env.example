# ===================================================================
# E-Commerce AI - Variables de Entorno
# ===================================================================
# Copia este archivo a .env y configura los valores reales
# NUNCA comitas el archivo .env con valores reales

# ===================================================================
# Base de Datos (PostgreSQL + pgvector)
# ===================================================================
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_segura

# Configuración del pool de conexiones
DB_CONNECTION_TIMEOUT=30000
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# ===================================================================
# JWT Security
# ===================================================================
# OBLIGATORIA: secreto para firmar/verificar tokens JWT (HS256).
# Debe tener al menos 256 bits (32 caracteres). Si falta o es corto,
# la aplicación NO arranca (fail-fast). Genéralo con: openssl rand -hex 32
JWT_SECRET=cambia_este_valor_por_uno_generado_con_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000
# Opcional: emisor esperado en el claim "iss" del token. Si se define, los tokens
# con un "iss" distinto o sin "iss" serán rechazados. Vacío = no validar issuer.
JWT_ISSUER=

# ===================================================================
# Hugging Face API Keys
# ===================================================================
# API key para Hugging Face (usada para embeddings y chat)
# Obtén tu key en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_tu_api_key_aqui

# Opcional: API key específica para chat (si es diferente)
HUGGINGFACE_CHAT_API_KEY=

# Opcional: Modelo de embeddings (default: sentence-transformers/all-MiniLM-L6-v2)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Opcional: Base URL para embeddings
HUGGINGFACE_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models

# Opcional: Modelo de chat (default: Meta-Llama/Llama-3.2-3B-Instruct)
HUGGINGFACE_CHAT_MODEL=Meta-Llama/Llama-3.2-3B-Instruct

# Opcional: Base URL para chat
HUGGINGFACE_CHAT_BASE_URL=https://router.huggingface.co/v1

# ===================================================================
# HTTP Client Configuration
# ===================================================================
HTTP_CLIENT_TIMEOUT=120000

# ===================================================================
# Server Configuration
# ===================================================================
SERVER_PORT=8080

# ===================================================================
# Logging Configuration
# ===================================================================
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_HIBERNATE=INFO

# ===================================================================
# CORS Configuration
# ===================================================================
# Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=*
CORS_MAX_AGE=3600

# ===================================================================
# JPA Configuration
# ===================================================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true