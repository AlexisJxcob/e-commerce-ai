# ===================================================================
# E-Commerce AI - Variables de Entorno
# ===================================================================
# Copia este archivo a .env y configura los valores reales
# NUNCA comitas el archivo .env con valores reales

# ===================================================================
# Base de Datos — Neon Postgres serverless (pgvector)
# ===================================================================
# Neon entrega DOS connection strings para la misma base:
#
#   DATABASE_URL        -> endpoint POOLED  (el host lleva el sufijo
#                          `-pooler`). Es el que usa la aplicación:
#                          PgBouncer multiplexa las conexiones, que es lo
#                          que necesita una arquitectura serverless.
#   DATABASE_DIRECT_URL -> endpoint DIRECTO (host SIN sufijo `-pooler`).
#                          Lo usa Flyway para migrar (PgBouncer en modo
#                          transacción no soporta el estado de sesión de las
#                          migraciones) y también pg_dump / pg_restore.
#
# Ambas DEBEN terminar en `?sslmode=require` (Neon rechaza conexiones sin
# TLS con "connection is insecure (try using `sslmode=require`)"). Se
# recomienda añadir `&channel_binding=require`, como hace el propio panel
# de Neon. Como el valor contiene `&`, va entre comillas simples en `.env`.
#
# Obtén los valores con:  neon connection-string --pooled   (DATABASE_URL)
#                         neon connection-string            (DATABASE_DIRECT_URL)
#
# Usa el host JDBC (`jdbc:postgresql://…`), no el esquema `postgresql://…`:
# Spring Boot sólo acepta URLs JDBC.
DATABASE_URL='jdbc:postgresql://<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require'
DATABASE_DIRECT_URL='jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require'
# pgjdbc no admite credenciales embebidas en la URL (`postgresql://user:pass@host`
# falla con "JDBC URL invalid port number"), así que van en variables aparte.
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=tu_password_de_neon

# Configuración del pool de conexiones (HikariCP, afinada para Neon serverless)
DB_CONNECTION_TIMEOUT=20000
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=600000
DB_KEEPALIVE_TIME=60000
# -1 = el pool arranca aunque el compute de Neon esté suspendido en ese momento
DB_INITIALIZATION_FAIL_TIMEOUT=-1

# ===================================================================
# Suite de integración contra una rama Neon de pruebas (opcional)
# ===================================================================
# Si NEON_TEST_DATABASE_URL está definida, AbstractIntegrationTest deja de
# levantar Testcontainers y ejecuta la suite completa contra esa rama.
# Usa SIEMPRE una rama desechable: los tests escriben y borran datos.
NEON_TEST_DATABASE_URL='jdbc:postgresql://<endpoint-test>-pooler.<region>.aws.neon.tech/<db>?sslmode=require'
NEON_TEST_DATABASE_DIRECT_URL='jdbc:postgresql://<endpoint-test>.<region>.aws.neon.tech/<db>?sslmode=require'
NEON_TEST_DATABASE_USER=neondb_owner
NEON_TEST_DATABASE_PASSWORD=tu_password_de_neon

# ===================================================================
# JWT Security
# ===================================================================
# OBLIGATORIA: secreto para firmar/verificar tokens JWT (HS256).
# Debe tener al menos 256 bits (32 caracteres). Si falta o es corto,
# la aplicación NO arranca (fail-fast). Genéralo con: openssl rand -hex 32
JWT_SECRET=cambia_este_valor_por_uno_generado_con_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000
# Opcional: emisor esperado en el claim "iss" del token. Si se define, los tokens
# con un "iss" distinto o sin "iss" serán rechazados. Vacío = no validar issuer.
JWT_ISSUER=

# ===================================================================
# Hugging Face API Keys
# ===================================================================
# API key para Hugging Face (usada para embeddings y chat)
# Obtén tu key en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_tu_api_key_aqui

# Opcional: API key específica para chat (si es diferente)
HUGGINGFACE_CHAT_API_KEY=

# Opcional: Modelo de embeddings (default: sentence-transformers/all-MiniLM-L6-v2)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Opcional: Base URL para embeddings
HUGGINGFACE_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models

# Opcional: Modelo de chat (default: Meta-Llama/Llama-3.2-3B-Instruct)
HUGGINGFACE_CHAT_MODEL=Meta-Llama/Llama-3.2-3B-Instruct

# Opcional: Base URL para chat
HUGGINGFACE_CHAT_BASE_URL=https://router.huggingface.co/v1

# ===================================================================
# HTTP Client Configuration
# ===================================================================
HTTP_CLIENT_TIMEOUT=120000

# ===================================================================
# Server Configuration
# ===================================================================
SERVER_PORT=8080

# ===================================================================
# Logging Configuration
# ===================================================================
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_HIBERNATE=INFO

# ===================================================================
# CORS Configuration
# ===================================================================
# Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=*
CORS_MAX_AGE=3600

# ===================================================================
# JPA Configuration
# ===================================================================
# El esquema lo gobierna Flyway: ddl-auto debe quedarse en validate en todos
# los entornos (un `update` aquí desactivaría esa garantía).
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true